# Wizard backend configuration. Copy to backend/.env and edit.
# Every value below is a default — the app runs with none of them set.

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
APP_NAME="Wizard"
ENV="dev"                       # dev | prod | test
SYSTEM_PROFILE="laptop"         # laptop | server | hpc

# ----------------------------------------------------------------------------
# Models
# ----------------------------------------------------------------------------
# API_PROVIDER is the *default* backend: ollama | lmstudio | openai |
# custom_gateway. It is not a lock-in — the UI picks a provider per role, so the
# planner can run on Ollama while the code model runs on LM Studio.
API_PROVIDER=ollama
#
# The three role models are EMPTY by default, which means "use whatever this
# provider actually has installed" — discovered at runtime and picked per role
# by capability. Set one to pin it; you do not need to.
#
# They used to be hardcoded to two Ollama tags, which made those exact models
# load-bearing: neither exists on LM Studio or on a gateway, so switching
# provider failed with a 404 until you also edited this file.
MODEL_NAME=""                   # plans and reasons; empty = auto-select
WORKER_MODEL_NAME=""            # writes the Python; empty = auto-select
VISION_MODEL_NAME=""            # describes charts (only when VISION_ENABLED)
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
OLLAMA_BASE_URL="http://host.docker.internal:11434"

# LM Studio. Give the root, not the "/v1" endpoint its UI displays — a trailing
# "/v1" is stripped, because discovery also uses the native /api/v0 API.
# Two things to check if the picker stays empty:
#   1. the server is started (LM Studio -> Developer -> Start Server), and
#   2. "Serve on Local Network" is on. LM Studio binds loopback by default, so
#      the backend container cannot reach it otherwise.
# Use http://localhost:1234 instead when running the backend outside Docker.
LMSTUDIO_BASE_URL="http://host.docker.internal:1234"
LMSTUDIO_API_KEY=""             # LM Studio ignores it; for proxies that don't

# Users can switch models per session from the UI; these are only the defaults.
GATEWAY_API_URL=""
GATEWAY_API_KEY=""

TEMPERATURE=0.0
MAX_TOKENS=4096
LLM_NUM_CTX=16384
LLM_NUM_THREAD=8
LLM_REQUEST_TIMEOUT=300
MAX_CORRECTION_RETRIES=3

# ----------------------------------------------------------------------------
# Agentic loop
# ----------------------------------------------------------------------------
# The analysis is an observe → decide → act loop: the agent sees real execution
# output and chooses what to do next, rather than following a plan fixed before
# any data was touched. Each iteration costs one manager round-trip, so the
# budget is scaled to the model behind it.
#
# auto infers the tier from the manager model's parameter count:
#   < 4B  → compact   (short leash, no reflection, no verification pass)
#   4-30B → balanced
#   ≥ 30B → full
# Gateways report no parameter count and are treated as balanced.
AGENT_TIER=auto                 # auto | compact | balanced | full
AGENT_MAX_ITERATIONS=24         # hard ceiling regardless of tier or mode
AGENT_OBSERVATION_CHARS=4000    # execution output carried into the next decision
# Halt for plan approval before running. Off by default — an agent that asks
# permission for every question is not autonomous. Web search always asks.
AGENT_REQUIRE_APPROVAL=False
AGENT_VERIFY=True               # re-derive the headline result a second way
AGENT_GROUNDING_CHECK=True      # refuse numbers absent from real output
AGENT_EMIT_SCRIPT=True          # emit a reproducible script per analysis

# ----------------------------------------------------------------------------
# Context documents
# ----------------------------------------------------------------------------
# Data dictionaries, metric definitions, business rules. Hard questions usually
# turn on these rather than on the tables alone, so they are ingested alongside
# the datasets, chunked and retrieved during a run.
CONTEXT_DOCS_ENABLED=True
CONTEXT_DOC_MAX_BYTES=33554432  # 32MB
CONTEXT_CHUNK_CHARS=1200
CONTEXT_CHUNK_OVERLAP=150
CONTEXT_TOP_K=5

# ----------------------------------------------------------------------------
# Sandbox
# ----------------------------------------------------------------------------
# When false, no container is ever created and code runs in a restricted
# in-process interpreter. Set false for CI and for machines without Docker.
SANDBOX_ENABLED=True
# False lets the sandbox pip-install a missing package on demand, which needs
# network access. True is more secure but a missing library becomes a hard error.
SANDBOX_NETWORK_DISABLED=False
SANDBOX_DOCKER_RUNTIME=""       # e.g. "runsc" for gVisor kernel isolation
SANDBOX_MEM_LIMIT="2g"
SANDBOX_CPU_QUOTA=0             # 100000 == one CPU; 0 == unlimited
SANDBOX_PIDS_LIMIT=256
SANDBOX_EXEC_TIMEOUT=180        # seconds per execution

# ----------------------------------------------------------------------------
# Output
# ----------------------------------------------------------------------------
PLOT_FORMAT=html                # html = interactive Plotly, png = static image

# ----------------------------------------------------------------------------
# Ingestion limits
# ----------------------------------------------------------------------------
MAX_UPLOAD_BYTES=536870912      # 512MB
MAX_INMEMORY_ROWS=2000000       # beyond this the frame is sampled for analysis
PROFILE_SAMPLE_ROWS=200000      # rows used when profiling a large file
PROMPT_MAX_COLUMNS=60           # wide frames send only the relevant columns

# ----------------------------------------------------------------------------
# Sessions
# ----------------------------------------------------------------------------
SESSION_TTL_SECONDS=21600
SESSION_MAX_ACTIVE=32
SESSION_HISTORY_TURNS=8

# ----------------------------------------------------------------------------
# Retrieval
# ----------------------------------------------------------------------------
RAG_ENABLED=True
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.35
SEMANTIC_CACHE_THRESHOLD=0.92
TRAJECTORY_MIN_SIMILARITY=0.90
# Skip the sentence-transformers download and use a hashing encoder instead.
# Needed for air-gapped installs; also used by CI.
EMBEDDINGS_FORCE_FALLBACK=False

# ----------------------------------------------------------------------------
# Review
# ----------------------------------------------------------------------------
COUNCIL_ENABLED=True
COUNCIL_TIMEOUT=20.0
VISION_ENABLED=False            # costs an extra multimodal call per chart

# ----------------------------------------------------------------------------
# Optional Redis (shared cache + job state). Empty = in-process, no service.
# ----------------------------------------------------------------------------
REDIS_URL=""
QUEUE_MAX_WORKERS=2
JOB_RESULT_TTL_SECONDS=3600

# ----------------------------------------------------------------------------
# Transport security
# ----------------------------------------------------------------------------
# Comma-separated. "*" is honoured but forces credentials off.
CORS_ALLOW_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# When set, mutating routes require this value in the X-API-Key header.
API_KEY=""
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
WS_MAX_CONCURRENT_PER_IP=4
