# Wizard backend configuration. Copy to backend/.env and edit.
# Every value below is a default — the app runs with none of them set.

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
APP_NAME="Wizard"
ENV="dev"                       # dev | prod | test
SYSTEM_PROFILE="laptop"         # laptop | server | hpc

# ----------------------------------------------------------------------------
# Models
# ----------------------------------------------------------------------------
# API_PROVIDER selects the client: "ollama" talks to a local daemon, anything
# else goes to an OpenAI-compatible gateway at GATEWAY_API_URL.
API_PROVIDER=ollama
MODEL_NAME="deepseek-r1:1.5b"          # plans the analysis and writes the answer
WORKER_MODEL_NAME="qwen2.5-coder:1.5b" # writes the Python
VISION_MODEL_NAME="llava:7b"           # describes charts (only when VISION_ENABLED)
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
OLLAMA_BASE_URL="http://host.docker.internal:11434"

# Users can switch models per session from the UI; these are only the defaults.
GATEWAY_API_URL=""
GATEWAY_API_KEY=""

TEMPERATURE=0.0
MAX_TOKENS=4096
LLM_NUM_CTX=16384
LLM_NUM_THREAD=8
LLM_REQUEST_TIMEOUT=300
MAX_CORRECTION_RETRIES=3

# ----------------------------------------------------------------------------
# Sandbox
# ----------------------------------------------------------------------------
# When false, no container is ever created and code runs in a restricted
# in-process interpreter. Set false for CI and for machines without Docker.
SANDBOX_ENABLED=True
# False lets the sandbox pip-install a missing package on demand, which needs
# network access. True is more secure but a missing library becomes a hard error.
SANDBOX_NETWORK_DISABLED=False
SANDBOX_DOCKER_RUNTIME=""       # e.g. "runsc" for gVisor kernel isolation
SANDBOX_MEM_LIMIT="2g"
SANDBOX_CPU_QUOTA=0             # 100000 == one CPU; 0 == unlimited
SANDBOX_PIDS_LIMIT=256
SANDBOX_EXEC_TIMEOUT=180        # seconds per execution

# ----------------------------------------------------------------------------
# Output
# ----------------------------------------------------------------------------
PLOT_FORMAT=html                # html = interactive Plotly, png = static image

# ----------------------------------------------------------------------------
# Ingestion limits
# ----------------------------------------------------------------------------
MAX_UPLOAD_BYTES=536870912      # 512MB
MAX_INMEMORY_ROWS=2000000       # beyond this the frame is sampled for analysis
PROFILE_SAMPLE_ROWS=200000      # rows used when profiling a large file
PROMPT_MAX_COLUMNS=60           # wide frames send only the relevant columns

# ----------------------------------------------------------------------------
# Sessions
# ----------------------------------------------------------------------------
SESSION_TTL_SECONDS=21600
SESSION_MAX_ACTIVE=32
SESSION_HISTORY_TURNS=8

# ----------------------------------------------------------------------------
# Retrieval
# ----------------------------------------------------------------------------
RAG_ENABLED=True
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.35
SEMANTIC_CACHE_THRESHOLD=0.92
TRAJECTORY_MIN_SIMILARITY=0.90
# Skip the sentence-transformers download and use a hashing encoder instead.
# Needed for air-gapped installs; also used by CI.
EMBEDDINGS_FORCE_FALLBACK=False

# ----------------------------------------------------------------------------
# Review
# ----------------------------------------------------------------------------
COUNCIL_ENABLED=True
COUNCIL_TIMEOUT=20.0
VISION_ENABLED=False            # costs an extra multimodal call per chart

# ----------------------------------------------------------------------------
# Optional Redis (shared cache + job state). Empty = in-process, no service.
# ----------------------------------------------------------------------------
REDIS_URL=""
QUEUE_MAX_WORKERS=2
JOB_RESULT_TTL_SECONDS=3600

# ----------------------------------------------------------------------------
# Transport security
# ----------------------------------------------------------------------------
# Comma-separated. "*" is honoured but forces credentials off.
CORS_ALLOW_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# When set, mutating routes require this value in the X-API-Key header.
API_KEY=""
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
WS_MAX_CONCURRENT_PER_IP=4
