# TypeScript's incremental build cache. Regenerated by every `tsc` and every
# `next build`, so committing it means a dirty tree after any local build.
*.tsbuildinfo

# Training & Internal Development (Ignored for public release)
backend/train.py
backend/train_full.py
backend/push_to_hub.py
backend/dataset_generator.py
backend/evaluate.py
backend/dataset/
